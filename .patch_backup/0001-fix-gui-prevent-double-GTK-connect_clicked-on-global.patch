From 5242390f710299e3cf88180997a3431b28195a0b Mon Sep 17 00:00:00 2001
From: Yunus Emre YILMAZ <yunusemreyl@users.noreply.github.com>
Date: Wed, 9 Sep 2026 20:34:48 +0300
Subject: [PATCH 1/5] fix(gui): prevent double GTK connect_clicked on global
 color btn leading to color dialog crashes

---
 src/omen-gui/src/keyboardrgb.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/omen-gui/src/keyboardrgb.rs b/src/omen-gui/src/keyboardrgb.rs
index e29afa8..80252b2 100755
--- a/src/omen-gui/src/keyboardrgb.rs
+++ b/src/omen-gui/src/keyboardrgb.rs
@@ -417,6 +417,10 @@ fn build_interactive_keyboard(
     // ------------------------
     
     for (name, btn) in buttons_map.borrow().iter() {
+        if name == "global_color_btn" || (name.starts_with("c") && name.ends_with("_btn")) {
+            continue;
+        }
+        
         let b_map_inner = b_map_clone.clone();
         let name_inner = name.clone();
         let zc_inner = zone_colors.clone();
